<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_white"
        android:padding="16dp"
        android:text="🛒 My Cart"
        android:textColor="@color/brand_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:elevation="3dp" />

    <TextView
        android:id="@+id/txtCartEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="Your cart is empty 🛍️\nGo add some cool stuff!"
        android:textColor="@color/brand_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cartRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="6dp" />
</LinearLayout>
